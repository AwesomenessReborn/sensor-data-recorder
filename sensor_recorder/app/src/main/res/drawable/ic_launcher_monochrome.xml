    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M58.24,58.24 A6,6 0 0 1 58.24,49.76" />
</vector>
