    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.6"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M25.5,38 L38.5,38 A3.5,3.5 0 0 1 42,41.5 L42,66.5 A3.5,3.5 0 0 1 38.5,70 L25.5,70 A3.5,3.5 0 0 1 22,66.5 L22,41.5 A3.5,3.5 0 0 1 25.5,38 Z" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.6"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M69.5,38 L82.5,38 A3.5,3.5 0 0 1 86,41.5 L86,66.5 A3.5,3.5 0 0 1 82.5,70 L69.5,70 A3.5,3.5 0 0 1 66,66.5 L66,41.5 A3.5,3.5 0 0 1 69.5,38 Z" />

    <!-- Link: centre node plus signal arcs -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M51.8,54 A2.2,2.2 0 1 0 56.2,54 A2.2,2.2 0 1 0 51.8,54 Z" />
    <path
        android:strokeColor="#FFFFFFFF"
